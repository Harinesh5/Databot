import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# Write code here

df = dfs[0].copy()

# Convert HORSEPOWER to numeric, coercing errors to NaN
df['HORSEPOWER'] = pd.to_numeric(df['HORSEPOWER'], errors='coerce')

# Define high-performance cars
df['is_high_performance'] = (df['HORSEPOWER'] > 200)

# Calculate the proportion of high-performance cars for each continent
continent_performance_proportion = df.groupby('CONTINENT')['is_high_performance'].mean()

# Sort the proportions for better visualization
