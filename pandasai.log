df['is_high_performance'] = df['HORSEPOWER'] > 200

# Group by CONTINENT and calculate the sum of high-performance cars and total cars
continent_performance = df.groupby('CONTINENT').agg(
    high_performance_count=('is_high_performance', 'sum'),
    total_cars=('ID', 'count')
)

# Calculate the proportion
